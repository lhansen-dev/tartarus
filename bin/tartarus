#!/usr/bin/env bash
# tartarus: run AI coding agents (Copilot, Claude Code, Codex) inside Docker Sandboxes (sbx).
set -euo pipefail

ROOT="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/.." && pwd)"  # resolve symlinks on PATH
BASELINE_KIT="${TARTARUS_BASELINE_KIT:-$ROOT/kits/team-baseline}"
KIT_SOURCES="${TARTARUS_KIT_SOURCES:-[\"docker.io/sbx/\"]}"
DENY_FILE="${TARTARUS_DENY_FILE:-$ROOT/policy/deny.txt}"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/tartarus"
SIGNING_KEY="${TARTARUS_SIGNING_KEY:-$CONFIG/kit-signing.key}"  # private; never in the repo
REPO_PUB="$ROOT/kits/signing.pub"                                # published with the kits
PINNED_PUB="$CONFIG/kit-signing.pub"                             # what setup told sbx to trust
SIGNERS="$CONFIG/trusted-signers.json"                           # the full signer list setup set
CPUS="${TARTARUS_CPUS:-4}"
MEMORY="${TARTARUS_MEMORY:-8g}"

# Host settings tartarus pins. `audit` fails if any drifts.
SETTINGS=(
  ssh.agentForwardingEnabled=false  # 1Password's agent would hand over every key
  clipboard.imagePaste=false        # the image runs a host clipboard bridge
  claude.remoteControl=false        # remote-control is an inbound channel to the agent
  env.rememberHostCommands=false    # every host command an env runs needs fresh approval
  skills.defaultMode=off            # no host skills store linked into sandboxes
  ssh.autoCreate=false              # an SSH connect must not create a sandbox outside tartarus
  kit.ignoreTransparencyLog=false   # keyless kit signatures must be in the transparency log
  tls.allowNegativeSerial=false     # no relaxed certificate checks on the proxy
  diagnostics.autoUpload=no         # error bundles hold logs and paths; never upload them
)

usage() {
  cat <<'EOF'
Usage: tartarus <command> [args]

  setup                         Harden sbx on this machine: pinned settings, deny-all network policy.
                                Resets the global network policy (per-sandbox kit rules are kept)
                                and restarts the sbx daemon, which stops running sandboxes.
  audit                         Check this machine's sbx settings, policy and secrets match setup
  config                        Show every setting, its current value and where to change it
  login <harness>               Store the harness credential in the host keychain (never enters the VM)
  run <harness> [--name N] [--detach] [path...] [-- agent args]
                                Start the harness in a clone-mode sandbox with the team kit.
                                First path is the repo the agent changes (default: .). Extra paths
                                are mounted read-only; suffix one with :rw to make it writable.
                                Refuses paths holding home dotfiles, untracked secret-looking
                                files (.env, *.pem...) or credentials in .git/config.
  verify <sandbox-name>         Run audit, then the in-sandbox battery: secrets, host surfaces, egress
  review <sandbox-name> <branch>
                                Fetch the agent's branch to the host without checking it out, and flag
                                changed files that run code on the host (hooks, CI, IDE tasks, builds).
                                Exits 2 when any are found.
  sign-kits                     Sign kits/*/ and policy/*.txt with the team key (made on first use, kept
                                outside the repo); commit kits/signing.pub and the signature files
  dismiss [sandbox-name...]     Dismiss pending approval prompts (all, or the named sandboxes'). Never allow
                                one: approving saves a permanent allow that audit then fails on.
  rm <sandbox-name>...          Remove sandboxes, their approval prompts, and the refs/sandboxes/<name>/*
                                refs sbx keeps in this repo. Branch anything you want first:
                                git branch X sandbox-<name>/Y
  safe <harness> [args]         Run the harness on the host in a scrubbed env (when sbx is not an option)

Harnesses: copilot, claude, codex
Env: TARTARUS_SIGNING_KEY, TARTARUS_ALLOW_ROOT=1 (keep sudo/Docker for the agent), TARTARUS_REGISTRIES=1
     (allow npm and PyPI), TARTARUS_ALLOW_SECRET_FILES=1 (mount paths holding .env, keys and the like), TARTARUS_REPIN=1 (trust a changed kits/signing.pub), TARTARUS_CPUS (4), TARTARUS_MEMORY (8g), TARTARUS_BASELINE_KIT, TARTARUS_KIT_SOURCES, TARTARUS_DENY_FILE
EOF
}

die() { echo "tartarus: $*" >&2; exit 1; }
# sbx's own rule. Also keeps a name from reaching sbx as a flag (rm --all would remove every sandbox).
check_name() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9.-]+$ && "$1" != default ]] || die "invalid sandbox name '$1' (letters, digits, - and .)"; }
json_eq() { python3 -c 'import json, sys; sys.exit(json.loads(sys.argv[1]) != json.loads(sys.argv[2]))' "$1" "$2" 2>/dev/null; }
indent() { while IFS= read -r line; do echo "          $line"; done <<<"$1"; }

# Per-harness wiring. Agent names and defaults are sbx's own: copilot --yolo,
# claude --dangerously-skip-permissions, codex --dangerously-bypass-approvals-and-sandbox.
harness_kit() {
  case "$1" in
    copilot) echo "docker.io/sbx/copilot-kit:latest" ;;
    claude|codex) ;;
    *) die "unknown harness '$1' (copilot, claude, codex)" ;;
  esac
}

# One host per line; blank lines and # comments (whole-line or trailing) are ignored. Anything
# that isn't a hostname or wildcard is refused: it would reach sbx as an argument, maybe a flag.
hosts_in() {
  [[ -f "$1" ]] || return 0
  local hosts bad
  hosts="$(sed -e 's/#.*//' -e 's/[[:space:]]//g' "$1" | grep -v '^$' || true)"
  bad="$(grep -vE '^(\*\*?\.)?[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$' <<<"$hosts" | grep -v '^$' || true)"
  [[ -z "$bad" ]] || die "$1: not a hostname: $(paste -sd' ' <<<"$bad")"
  [[ -z "$hosts" ]] || echo "$hosts"
}
deny_hosts() { hosts_in "$DENY_FILE"; }
# Hosts kits/registries allows; TARTARUS_REGISTRIES=1 lifts a harness deny on them.
registry_hosts() { sed -n 's/^ *- *\([A-Za-z0-9.-]*\) *$/\1/p' "$ROOT/kits/registries/spec.yaml"; }

# Policy files are signed like kits: an edited deny list would quietly loosen every sandbox.
# A missing file or signature fails too, so deleting a list can't open it up. No key, no check.
check_policy() { # check_policy <public key> <file>...
  [[ -f "$1" ]] || return 0
  local key="$1" f; shift
  for f; do
    [[ -f "$f" && -f "$f.sig" ]] && openssl dgst -sha256 -verify "$key" -signature "$f.sig" "$f" >/dev/null 2>&1 \
      || die "$f: signature missing or stale (tartarus sign-kits)"
  done
}
policy_files() { local f; echo "$DENY_FILE"; for f in "$ROOT"/policy/deny-*.txt; do echo "$f"; done; }

cmd_setup() {
  local kv
  # setup trusts whatever kits/signing.pub says, so a swapped key (with re-signed kits and
  # policy) would otherwise be trusted silently on the next run. Make that a deliberate step.
  # Deleting it counts as a change: that would switch signature checks off.
  if [[ -f "$PINNED_PUB" && "${TARTARUS_REPIN:-}" != 1 ]] && ! cmp -s "$REPO_PUB" "$PINNED_PUB"; then
    die "kits/signing.pub changed or was removed since the last setup; check who did it (git log kits/signing.pub), then TARTARUS_REPIN=1 tartarus setup"
  fi
  local policy; mapfile -t policy < <(policy_files)
  check_policy "$REPO_PUB" "${policy[@]}"
  deny_hosts >/dev/null  # refuse a bad entry before changing anything
  for kv in "${SETTINGS[@]}"; do sbx settings set "${kv%%=*}" "${kv#*=}"; done
  sbx settings set kit.allowedSources "$KIT_SOURCES"
  # Rebuild the global policy from scratch so stale allows can't survive a re-run.
  # In a terminal, reset asks for a policy itself, which then makes init fail; no stdin, no prompt.
  sbx policy reset --force </dev/null
  sbx policy init deny-all
  deny_hosts | while read -r host; do sbx policy deny network "$host"; done
  # With a team key, only kits it signed (plus Docker's built-in agents) can be installed. The
  # key is pinned outside the repo, so a changed signing.pub needs a deliberate re-run of setup.
  if [[ -f "$REPO_PUB" ]]; then
    mkdir -p "$CONFIG" && cp "$REPO_PUB" "$PINNED_PUB"
    sbx settings unset kit.trustedSigners >/dev/null 2>&1 || true
    local signers  # an assignment, so a failure here stops setup instead of trusting nobody
    signers="$(sbx settings get kit.trustedSigners | python3 -c '
import json, sys
print(json.dumps(json.load(sys.stdin) + [{"key": sys.argv[1]}]))' "$PINNED_PUB")"
    sbx settings set kit.trustedSigners "$signers"
    printf '%s\n' "$signers" > "$SIGNERS"
    sbx settings set kit.requireSignature true
  else
    rm -f "$PINNED_PUB" "$SIGNERS"
    sbx settings set kit.requireSignature false
    echo "tartarus: no kits/signing.pub; kit signatures not enforced (see: tartarus sign-kits)"
  fi
  # ssh.* settings only reach the daemon after a restart; this stops running sandboxes.
  sbx daemon restart
}

cmd_audit() {
  local fail=0 kv got
  for kv in "${SETTINGS[@]}"; do
    got="$(sbx settings get "${kv%%=*}" 2>/dev/null || true)"
    [[ "$got" == "${kv#*=}" ]] || { echo "  FAIL  ${kv%%=*} is '$got', want '${kv#*=}'"; fail=1; }
  done
  # audit runs inside $(...) for run, where set -e is off: every read below fails closed by hand.
  # Allows widen sandboxes past their kits. A kit's own are 'provisioned'; a global allow, a
  # hand-added one, or one saved by approving a blocked-request prompt (agents trigger those on
  # purpose) is not. Every deny.txt host must be in a global deny; an allow naming it doesn't count.
  local policy report hosts
  hosts="$(deny_hosts)"
  policy="$(sbx policy ls --json)" || policy=""
  report="$(python3 -c '
import json, sys
rules = json.load(sys.stdin)["rules"] or []
for r in rules:
    via = (r.get("provenance") or {}).get("created_via")
    if r["resource_type"] == "network" and r["decision"] == "allow" and (r["scope"] == "global" or via != "provisioned"):
        fix = "" if r["scope"] == "global" else "  (sbx policy rm network --sandbox %s --resource HOST --force)" % r["scope"].split(":", 1)[-1]
        print("  FAIL  network allow (%s, %s): %s%s" % (r["scope"], via, ", ".join(r["resources"]), fix))
denied = {h for r in rules if r["scope"] == "global" and r["decision"] == "deny" for h in r["resources"]}
for h in sys.argv[1].split():
    if h not in denied: print("  FAIL  deny rule missing: " + h)' "$hosts" <<<"$policy" 2>/dev/null)" \
    || report="  FAIL  can't read the sbx policy (sbx policy ls --json)"
  # Approval-made allows are listed apart too, in case the full listing ever leaves them out.
  report+="$(sbx policy ls --json --created-via approval | python3 -c '
import json, sys
for r in json.load(sys.stdin).get("rules") or []:
    if r["decision"] == "allow": print("\n  FAIL  allow made by approving a prompt (%s): %s" % (r["scope"], ", ".join(r["resources"])))' 2>/dev/null)" \
    || report+=$'\n'"  FAIL  can't list approval-made rules"
  report="$(sed '/^$/d' <<<"$report" | sort -u)"
  [[ -z "$report" ]] || { echo "$report"; fail=1; }
  local pending
  pending="$(sbx policy approval ls 2>/dev/null | tail -n +2 | wc -l | tr -d ' ')"
  ((pending == 0)) || echo "  info  $pending pending approval prompt(s): never allow them; clear them with tartarus dismiss"
  json_eq "$(sbx settings get kit.allowedSources 2>/dev/null)" "$KIT_SOURCES" \
    || { echo "  FAIL  kit.allowedSources is not $KIT_SOURCES"; fail=1; }
  # A pinned key with no kits/signing.pub means someone deleted it: check, and fail on, both.
  if [[ -f "$REPO_PUB" || -f "$PINNED_PUB" ]]; then
    [[ "$(sbx settings get kit.requireSignature)" == true ]] || { echo "  FAIL  kit.requireSignature is off"; fail=1; }
    cmp -s "$REPO_PUB" "$PINNED_PUB" || { echo "  FAIL  kits/signing.pub is not the key tartarus setup pinned ($PINNED_PUB); run setup"; fail=1; }
    # An extra signer would let kits signed by anyone else in.
    json_eq "$(sbx settings get kit.trustedSigners 2>/dev/null)" "$(cat "$SIGNERS" 2>/dev/null)" \
      || { echo "  FAIL  kit.trustedSigners differs from what setup set ($SIGNERS)"; fail=1; }
    local kit
    for kit in "$ROOT"/kits/*/; do
      sbx kit verify --key "$PINNED_PUB" "$kit" >/dev/null 2>&1 \
        || { echo "  FAIL  $(basename "$kit") kit signature missing or stale (tartarus sign-kits)"; fail=1; }
    done
    local f
    while read -r f; do
      (check_policy "$PINNED_PUB" "$f") 2>/dev/null || { echo "  FAIL  $f signature missing or stale (tartarus sign-kits)"; fail=1; }
    done < <(policy_files)
  fi
  # Every sandbox reaches the MCP gateway (a daemon alias that deny rules don't cover), so any
  # registered server is exposed to every agent; host stdio servers run commands on the host.
  local mcp; mcp="$(sbx mcp ls 2>&1 || true)"
  [[ "$mcp" == *"No MCP servers registered"* ]] || { echo "  FAIL  MCP servers registered (sbx mcp ls):"; indent "$mcp"; fail=1; }
  # A github secret would let the proxy push to github.com for the agent.
  local secrets; secrets="$(sbx secret ls --quiet)" || { echo "  FAIL  can't list secrets (sbx secret ls)"; fail=1; }
  if grep -qx github <<<"$secrets"; then echo "  FAIL  'github' secret stored"; fail=1; fi
  ((fail)) && { echo "audit: FAIL (settings and policy: tartarus setup; others: fix as listed)"; return 1; }
  echo "audit: OK (settings pinned, global policy deny-all, no github secret)"
}

cmd_login() {
  case "${1:-}" in
    # Only the Copilot API credential; no `github` secret, so the sandbox can't push to github.com.
    copilot) sbx secret set copilot ;;
    codex) sbx secret set openai --oauth ;;
    claude)
      echo "Claude Code: subscriptions sign in with /login inside the sandbox (OAuth; token stays on the host)."
      echo "Storing an Anthropic API key instead (Ctrl-C to skip):"
      sbx secret set anthropic ;;
    *) die "login needs a harness: copilot, claude, codex" ;;
  esac
}

# Files whose names say credential: those git doesn't track (untracked or ignored), or every
# file outside a repo. Examples and templates (.env.example) are fine.
secret_files() {
  { git -C "$1" ls-files -z --others 2>/dev/null || (cd "$1" 2>/dev/null && find . -type f -print0); } \
    | grep -zaiE '(^|/)(\.env(\.[^/]*)?|[^/]*\.(pem|key|p12|pfx|jks|keystore|tfvars|tfstate)|id_(rsa|dsa|ecdsa|ed25519)|\.netrc|\.npmrc|\.pypirc|\.git-credentials|\.dockercfg|kubeconfig|credentials(\.json)?|secrets?\.(ya?ml|json|toml|env)|service-account[^/]*\.json)$' \
    | grep -zaivE '\.(example|sample|template|dist)$' | tr '\0' '\n' || true
}

# Every path the VM sees is mounted whole (clone mode too, read-only at /run/sandbox/source):
# untracked and ignored files and .git/config included.
refuse_exposed() {
  local leaked
  leaked="$(git -C "$1" config --local --get-regexp '^(remote\..*\.url|http\..*extraheader)$' 2>/dev/null \
    | grep -iE '://[^/@:]+:[^/@]+@|authorization' | cut -d' ' -f1 || true)"
  [[ -z "$leaked" ]] || die "$1/.git/config holds credentials the agent would see ($(paste -sd' ' <<<"$leaked")); remove them first"
  [[ "${TARTARUS_ALLOW_SECRET_FILES:-}" == 1 ]] && return
  leaked="$(secret_files "$1")"
  [[ -z "$leaked" ]] || die "files in $1 look like secrets the agent would see:
$(head -n 20 <<<"$leaked" | sed 's/^/  /')
move them out, or TARTARUS_ALLOW_SECRET_FILES=1 if they're harmless"
}

cmd_run() {
  local harness="${1:-}"; [[ -n "$harness" ]] || die "run needs a harness"; shift
  local kit; kit="$(harness_kit "$harness")"
  local args=(run --clone --skills off --cpus "$CPUS" --memory "$MEMORY" --kit "$BASELINE_KIT")
  [[ "${TARTARUS_ALLOW_ROOT:-}" == 1 ]] || args+=(--kit "$ROOT/kits/no-root")
  [[ "${TARTARUS_REGISTRIES:-}" == 1 ]] && args+=(--kit "$ROOT/kits/registries")
  [[ -n "$kit" ]] && args+=(--kit "$kit")
  # A drifted machine (an approved prompt's allow, a registered MCP server, an unsigned deny
  # list) would widen every new sandbox, so it doesn't get one.
  local report; report="$(cmd_audit)" || die "audit failed; fix it before running an agent:
$report"
  local host denies
  # Narrow the harness kit's own allows (connectors, remote control, GitHub) for this sandbox.
  denies="$(hosts_in "$ROOT/policy/deny-$harness.txt")"
  [[ "${TARTARUS_REGISTRIES:-}" == 1 ]] && denies="$(grep -vxF -f <(registry_hosts) <<<"$denies" || true)"
  while read -r host; do if [[ -n "$host" ]]; then args+=(--deny-network "$host"); fi; done <<<"$denies"
  local paths=() rest=()
  while (($#)); do
    case "$1" in
      --name) [[ $# -ge 2 ]] || die "--name needs a value"; check_name "$2"; args+=(--name "$2"); shift 2 ;;
      --detach|-d) args+=(--detach); shift ;;
      --) shift; rest=("$@"); break ;;
      # sbx parses flags anywhere, so a stray --kit or --skills would reach it as a path.
      -*) die "unknown option $1 (prefix a path that starts with - with ./)" ;;
      *) paths+=("$1"); shift ;;
    esac
  done
  ((${#paths[@]})) || paths=(.)
  local i primary extra home
  primary="$(realpath -m "${paths[0]}")"
  home="$(realpath -m "$HOME")"
  # Home dotdirs hold keys and tokens (.ssh, .aws, .config, .kube); read-only still leaks them.
  holds_dotfiles() { [[ "$home/" == "${1%/}/"* || "$1" == "$home"/.* ]]; }  # ${1%/}: / itself holds home
  holds_dotfiles "$primary" && die "$primary is or holds your home's dotfiles (keys, tokens); run from a repo"
  refuse_exposed "$primary"
  # sbx ignores creation flags when it re-attaches to an existing sandbox, so the default name
  # carries a fingerprint of the lockdown config: harden tartarus and you get a fresh sandbox.
  if [[ " ${args[*]} " != *" --name "* ]]; then
    local fp
    # A remote kit (git/OCI URL) has no local spec; its pinned ref in the URL stands in for it.
    fp="$({ cat "$0" "$ROOT"/policy/*.txt "$ROOT"/kits/no-root/spec.yaml; cat "$BASELINE_KIT/spec.yaml" 2>/dev/null || true
      echo "$BASELINE_KIT $CPUS $MEMORY ${TARTARUS_ALLOW_ROOT:-} ${TARTARUS_REGISTRIES:-}"; } | cksum | cut -d' ' -f1)"
    local base; base="$(basename "$primary")"
    args+=(--name "tartarus-$harness-${base//[^A-Za-z0-9.-]/-}-$fp")  # sbx names: letters, digits, - and .
  fi
  # Clone mode only protects the first path; extras are direct mounts, so default them to :ro.
  for ((i = 1; i < ${#paths[@]}; i++)); do
    extra="$(realpath -m "${paths[i]%:r[ow]}")"
    # An extra containing the repo would mount it directly, bypassing clone mode.
    [[ "$primary/" == "${extra%/}/"* || "$extra/" == "$primary/"* ]] \
      && die "extra path ${paths[i]} overlaps the repo $primary; mount siblings only"
    holds_dotfiles "$extra" && die "extra path ${paths[i]} is or holds your home's dotfiles (keys, tokens); refused"
    refuse_exposed "$extra"
    case "${paths[i]}" in
      *:rw) paths[i]="${paths[i]%:rw}" ;;
      *:ro) ;;
      *) paths[i]+=":ro" ;;
    esac
  done
  args+=("$harness" "${paths[@]}")
  ((${#rest[@]})) && args+=(-- "${rest[@]}")
  exec sbx "${args[@]}"
}

# Files that run code on the host when you build, test, open or commit: the trust-handoff path.
# Each entry matches from the start of a path component, as a prefix unless it ends in $.
RISKY=(
  # Git: hooks, filters and submodules.
  '\.git/|\.githooks/|\.husky|\.gitattributes|\.gitmodules|\.lfsconfig|\.pre-commit|lefthook|\.?simple-git-hooks|\.lintstagedrc|lint-staged\.config'
  # CI: runs with CI secrets once pushed.
  '\.github/|\.gitlab-ci|\.gitlab/|\.gitea/|\.forgejo/|\.circleci/|Jenkinsfile|\.buildkite/|azure-pipelines|\.travis\.yml|bitbucket-pipelines|\.drone\.yml|cloudbuild|\.woodpecker|appveyor|\.semaphore/|\.tekton/'
  # IDEs and editors, which run tasks, launch configs and language servers on open.
  '\.vscode/|\.idea/|\.fleet/|\.zed/|\.helix/|\.devcontainer|.*\.code-workspace$|.*\.sublime-project$|\.exrc|\.nvimrc|\.nvim\.lua|\.lazy\.lua|\.dir-locals\.el|\.ycm_extra_conf\.py'
  # Agent config and instructions: prompt injection aimed at the next agent you run on the host.
  '\.claude/|\.codex/|\.cursor/|\.gemini/|\.continue/|\.windsurf/|\.kiro/|\.roo|\.amazonq/|\.junie/|\.opencode|opencode\.jsonc?$|\.factory/|\.agents/|\.augment|\.trae/|\.qwen/|\.crush|\.aider|\.goosehints|\.mcp\.json|CLAUDE(\.local)?\.md|AGENTS\.md|GEMINI\.md|\.cursorrules|\.windsurfrules|\.clinerules'
  # Environment managers and dotenv files, which set PATH, LD_PRELOAD or NODE_OPTIONS for later commands.
  '\.env|\.direnv/|\.?mise[./]|\.tool-versions|.*\.nix$|flake\.lock|devenv\.|devbox\.json|pixi\.toml|rust-toolchain|\.sdkmanrc|Brewfile|Procfile|Vagrantfile|Tiltfile'
  # Build and task files.
  'Makefile|makefile|GNUmakefile|.*\.mk$|justfile|Taskfile|Rakefile|[Gg]runtfile|[Gg]ulpfile|CMakeLists\.txt|.*\.cmake$|CMake(User)?Presets\.json|meson\.build|configure(\.ac)?$|conanfile|vcpkg|build\.rs|build\.zig|Package\.swift|Podfile|Cartfile|mix\.exs|rebar\.config|.*\.cabal$|Setup\.l?hs$|stack\.yaml|Dockerfile|Containerfile|docker-compose|compose\.ya?ml|docker-bake'
  '\.bazelrc|\.bazelversion|BUILD(\.bazel)?$|WORKSPACE(\.bazel)?$|MODULE\.bazel|.*\.bzl$|BUCK$|\.buckconfig|pants\.toml'
  # JVM and .NET builds: wrappers and properties can fetch and run any build tool or JVM agent.
  '.*\.gradle(\.kts)?$|gradlew|gradle\.properties|gradle-wrapper\.properties|buildSrc/|mvnw|\.mvn/|pom\.xml|.*\.sbt$|\.sbtopts|\.jvmopts|project/[^/]*\.scala$|.*\.(cs|fs|vb)proj$|.*\.(props|targets)$|nuget\.config|global\.json'
  # Package manager config and manifests: install scripts, registries, plugins.
  '\.npmrc|\.yarnrc|\.yarn/|\.pnpmfile|pnpm-workspace\.yaml|bunfig\.toml|deno\.jsonc?$|package\.json|nodemon\.json|\.cargo/|Cargo\.toml|go\.mod|go\.work|composer\.(json|lock)|Gemfile|.*\.gemspec$|\.bundle/|\.rspec|setup\.py|setup\.cfg|hatch_build\.py|pyproject\.toml|requirements.*\.txt|Pipfile'
  # Lockfiles can point a package at any tarball URL without a manifest change.
  'package-lock\.json|npm-shrinkwrap\.json|yarn\.lock|pnpm-lock\.yaml|bun\.lockb?|poetry\.lock|uv\.lock|Pipfile\.lock|pdm\.lock|Cargo\.lock|go\.sum|Gemfile\.lock'
  # Language startup hooks and tool configs that load code: IDEs and linters run these on open.
  'conftest\.py|tox\.ini|noxfile\.py|pytest\.ini|sitecustomize\.py|usercustomize\.py|.*\.pth$|\.?pylintrc|\.?mypy\.ini|\.pdbrc|\.irbrc|\.pryrc|\.gdbinit|\.lldbinit|\.php-cs-fixer'
  '.*\.config\.[cm]?[jt]s$|.*\.conf\.[cm]?[jt]s$|.*\.workspace\.[cm]?[jt]s$|\.[a-z]+rc\.[cm]?js$|\.babelrc|babel\.config|\.storybook/'
  # Infrastructure as code: terraform plan runs external data sources; ansible loads ./ansible.cfg.
  '.*\.tf$|.*\.tofu$|\.terraformrc|terragrunt\.hcl|ansible\.cfg'
  # Compiled code nobody can review by reading the diff; gradlew runs gradle-wrapper.jar, Python
  # imports a .pyc that has no .py, Node loads .node addons.
  '.*\.(jar|war|class|pyc|pyo|so|dylib|dll|exe|node|wasm|whl|egg|a|o)$'
)
RISKY_PATHS="(^|/)($(IFS='|'; echo "${RISKY[*]}"))"

# Commit messages and file names come from the agent: escape sequences in them could erase or
# fake the warnings below, so control characters (C0, DEL and C1) print as '?'.
sanitize() { python3 -c '
import re, sys
sys.stdin.reconfigure(errors="replace")
sys.stdout.write(re.sub(r"[\x00-\x08\x0b-\x1f\x7f-\x9f]", "?", sys.stdin.read()))'; }

cmd_review() {
  local rc=0
  review_branch "$@" 2>&1 | sanitize || rc=$?
  return "$rc"
}

review_branch() {
  local name="${1:-}" branch="${2:-}"
  [[ -n "$name" && -n "$branch" ]] || die "review needs a sandbox name and branch"
  check_name "$name"
  # --no-tags: the agent's tags would land in this repo, where a tag named main shadows the
  # branch (here and in every later git command) and a v1.2.3 can reach a release pipeline.
  # tagOpt keeps it that way for any later fetch of this remote (git fetch --all included).
  local remote="sandbox-$name"
  git config "remote.$remote.url" >/dev/null || die "no git remote $remote; is $name a sandbox of this repo?"
  git config "remote.$remote.tagOpt" --no-tags
  git fetch --no-tags "$remote"
  # Full refnames from here on: a short name like main can resolve to something else.
  local ref="refs/remotes/$remote/$branch" range
  git rev-parse --verify -q "$ref^{commit}" >/dev/null || {
    echo "tartarus: no branch '$branch' in $name; it has:"
    git for-each-ref --format='  %(refname:lstrip=3)' "refs/remotes/$remote/"
    return 1
  }
  range="HEAD...$ref"
  git log --oneline "HEAD..$ref"
  git diff --stat "$range"
  # -z: no quoting of odd names to slip past ^; --no-renames: list both ends of a move;
  # -i: case-insensitive filesystems (macOS) open .VSCode/ as .vscode/.
  local risky links
  risky="$(git diff --no-renames --name-only -z "$range" | grep -izE "$RISKY_PATHS" | tr '\0' '\n' || true)"
  # A symlink can point a build or IDE at any host file once checked out; a moved submodule
  # pointer makes git submodule update check out other code with no .gitmodules change.
  links="$(git diff --no-renames --raw "$range" \
    | awk -F'\t' 'index($1, " 120000 ") {print $2 " (symlink)"} index($1, " 160000 ") {print $2 " (submodule)"}')"
  risky="$(printf '%s\n%s' "$risky" "$links" | sed '/^$/d')"
  # The list only covers files that run on their own. Running tests or the app runs every changed file.
  local after="Every changed file runs once you test, build or start the app on the host: read the whole
diff first, or run them in the sandbox (sbx exec -it $name bash)."
  if [[ -n "$risky" ]]; then
    echo; echo "REVIEW BEFORE CHECKOUT, BUILD OR OPENING IN AN IDE (these run code on the host):"
    printf '%s\n' "$risky" | sed 's/^/  /'
    echo; echo "$after"
    return 2
  fi
  echo; echo "No files that run on their own changed. $after"
}

cmd_sign_kits() {
  if [[ ! -f "$SIGNING_KEY" ]]; then
    mkdir -p "$(dirname "$SIGNING_KEY")"
    (umask 077 && openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -out "$SIGNING_KEY")
    openssl pkey -in "$SIGNING_KEY" -pubout -out "$REPO_PUB"
    echo "tartarus: new signing key $SIGNING_KEY; public key in kits/signing.pub"
  fi
  local kit f
  for kit in "$ROOT"/kits/*/; do
    # Sign first: with kit.requireSignature on, validate refuses an edited kit until it's re-signed.
    { sbx kit sign --key "$SIGNING_KEY" "$kit" && sbx kit validate "$kit"; } || die "signing $kit failed"
  done
  for f in "$ROOT"/policy/*.txt; do openssl dgst -sha256 -sign "$SIGNING_KEY" -out "$f.sig" "$f"; done
  echo "tartarus: commit kits/signing.pub, kits/*/kit.sig.bundle and policy/*.sig, then run tartarus setup"
}

# Read-only: where each setting lives and what it is now.
cmd_config() {
  local f
  list() { local l; l="$(paste -sd, - | sed 's/,/, /g')"; echo "${l:-(none)}"; }
  # Works with both yq flavours (Python/jq and Go); config is only a viewer, so yq stays optional.
  allows() { command -v yq >/dev/null || { echo "(install yq to list)"; return; }
    yq -r '(.permissions.network.allow // [])[]' "$1/spec.yaml" 2>/dev/null; }
  echo "Baseline kit  $BASELINE_KIT  ($( [[ -f "$BASELINE_KIT/kit.sig.bundle" ]] && echo "has kit.sig.bundle" || echo unsigned))  TARTARUS_BASELINE_KIT"
  echo "  allow       $(allows "$BASELINE_KIT" | list)"
  echo "Registries    $( [[ "${TARTARUS_REGISTRIES:-}" == 1 ]] && echo "allowed: $(allows "$ROOT/kits/registries" | list)" || echo "blocked")  TARTARUS_REGISTRIES=1 allows npm and PyPI"
  echo "Deny (global) $DENY_FILE: $(hosts_in "$DENY_FILE" | list)  TARTARUS_DENY_FILE"
  for f in "$ROOT"/policy/deny-*.txt; do
    printf '%-13s %s\n' "Deny ($(basename "$f" .txt | sed 's/^deny-//'))" "$(hosts_in "$f" | list)"
  done
  echo "Resources     cpus=$CPUS memory=$MEMORY  TARTARUS_CPUS / TARTARUS_MEMORY"
  echo "Secret files  $( [[ "${TARTARUS_ALLOW_SECRET_FILES:-}" == 1 ]] && echo allowed || echo "refused (.env, keys... outside git)")  TARTARUS_ALLOW_SECRET_FILES=1 allows them"
  echo "Root          $( [[ "${TARTARUS_ALLOW_ROOT:-}" == 1 ]] && echo kept || echo "dropped (kits/no-root)")  TARTARUS_ALLOW_ROOT=1 keeps it"
  echo "Kit sources   $KIT_SOURCES  TARTARUS_KIT_SOURCES"
  echo "Signing key   $SIGNING_KEY  TARTARUS_SIGNING_KEY"
  echo "Pinned        ${SETTINGS[*]}  (edit SETTINGS in bin/tartarus)"
  echo "Change a kit or policy file, then: tartarus sign-kits. Change policy or settings, then: tartarus setup."
}

# Dismiss (never allow) pending approval prompts: all of them, or those of the named sandboxes.
cmd_dismiss() {
  local name id box n=0
  for name in "$@"; do check_name "$name"; done
  while read -r id box _; do
    [[ $# == 0 || " $* " == *" $box "* ]] || continue
    sbx policy approval respond "$id" --option dismiss >/dev/null && n=$((n + 1))
  done < <(sbx policy approval ls | tail -n +2)
  echo "tartarus: dismissed $n approval prompt(s)"
}

cmd_rm() {
  local name
  (($#)) || die "rm needs one or more sandbox names"
  for name in "$@"; do check_name "$name"; done
  # A removed sandbox's prompts can only ever be allowed by mistake.
  cmd_dismiss "$@"
  for name in "$@"; do
    sbx rm --force "$name"
    # sbx rm leaves the fetched refs behind in the host repo.
    if git rev-parse --git-dir >/dev/null 2>&1; then
      git for-each-ref --format='%(refname)' "refs/sandboxes/$name/" | while read -r ref; do git update-ref -d "$ref"; done
      git remote remove "sandbox-$name" 2>/dev/null || true
    fi
  done
}

host_ips() {
  if command -v ip >/dev/null; then
    ip -4 -o addr show scope global | awk '{print $4}' | cut -d/ -f1
  else
    ifconfig 2>/dev/null | awk '/inet / && $2 != "127.0.0.1" {print $2}'
  fi
}

cmd_verify() {
  local name="${1:-}"; [[ -n "$name" ]] || die "verify needs a sandbox name"
  check_name "$name"
  local fail=0 ips
  cmd_audit || fail=1
  local policy; mapfile -t policy < <(policy_files)
  check_policy "$PINNED_PUB" "${policy[@]}"
  mapfile -t ips < <(host_ips)
  # Every denied host must be blocked in any sandbox (wildcards can't be requested directly).
  local blocked f
  # Registries are reported apart: a sandbox started with TARTARUS_REGISTRIES=1 reaches them.
  blocked="$({ deny_hosts; for f in "$ROOT"/policy/deny-*.txt; do hosts_in "$f"; done; } | grep -v '\*' | grep -vxF -f <(registry_hosts) || true)"
  # The script goes in as an argument, not a file: the agent can rewrite anything it can write.
  sbx exec "$name" sh -c "$(cat "$ROOT/libexec/verify-inside.sh")" verify-inside "$blocked" "${ips[@]}" 127.0.0.1 || fail=1
  echo "Review egress with: sbx policy log $name"
  return "$fail"
}

cmd_safe() {
  local harness="${1:-}"; [[ -n "$harness" ]] || die "safe needs a harness"; shift
  local cmd
  case "$harness" in
    copilot) cmd=(copilot --sandbox) ;;
    codex) cmd=(codex --sandbox workspace-write) ;;
    claude) cmd=(claude) ;; # keeps permission prompts on; no sandbox flag to add
    *) die "unknown harness '$harness' (copilot, claude, codex)" ;;
  esac
  # Drops VAULT_*, AWS_*, SSH_AUTH_SOCK, op-run injections; kubectl sees no clusters.
  exec env -i HOME="$HOME" PATH="$PATH" TERM="${TERM:-xterm}" KUBECONFIG=/dev/null "${cmd[@]}" "$@"
}

case "${1:-}" in
  setup) shift; cmd_setup "$@" ;;
  audit) shift; cmd_audit "$@" ;;
  config) shift; cmd_config "$@" ;;
  login) shift; cmd_login "$@" ;;
  run) shift; cmd_run "$@" ;;
  verify) shift; cmd_verify "$@" ;;
  review) shift; cmd_review "$@" ;;
  rm) shift; cmd_rm "$@" ;;
  dismiss) shift; cmd_dismiss "$@" ;;
  sign-kits) shift; cmd_sign_kits "$@" ;;
  safe) shift; cmd_safe "$@" ;;
  ""|-h|--help|help) usage ;;
  *) usage >&2; exit 1 ;;
esac
